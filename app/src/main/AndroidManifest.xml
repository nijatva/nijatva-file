<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="34"
    android:versionName="34.0">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

        <queries>
        <package android:name="com.nijatva.messages" />
        <package android:name="com.nijatva.contacts" />
        <package android:name="com.nijatva.dialer" />
        <package android:name="com.nijatva.file" />
        <package android:name="com.nijatva.gallery" />
        <package android:name="com.nijatva.camera" />
        <package android:name="com.nijatva.music.player" />
        <package android:name="in.nijatva.browser" />
        <package android:name="com.nijatva.drive" />
            <package android:name="com.nijatva.photos" />
        <package android:name="com.nijatva.photo.editor" />
        <package android:name="com.nijatva.videoplayer" />
        <package android:name="com.nijatva.mini.x" />
        <package android:name="com.nijatva.wtrlab" />
    </queries>
<application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity android:name=".MainActivity" android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- "Open with → Nijatva File" for the file types we actually handle -->
        <activity android:name=".OpenWithActivity" android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="resource/folder" />
            </intent-filter>
        </activity>
        <activity android:name=".AppearanceActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".DeveloperActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".AppManagerActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".PdfViewerActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".ShortcutActivity" android:exported="true"
            android:theme="@style/AppTheme" />
        <activity android:name=".DeviceInfoActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".ToolsActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".BrowserActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".MediaViewerActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".TextEditorActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".MimeTypesActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".StorageAnalysisActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".RecycleBinActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".FilesSettingsActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".CleanActivity" android:exported="false"
            android:theme="@style/AppTheme" />
        <activity android:name=".StarredActivity" android:exported="false"
            android:theme="@style/AppTheme" />

        <provider
            android:name=".FmProvider"
            android:authorities="com.nijatva.file.files"
            android:exported="false"
            android:grantUriPermissions="true" />
            <!-- Nijatva signature: who made this build, for anyone who inspects the APK -->
        <meta-data android:name="developer.name" android:value="Vasudev Dangaya" />
        <meta-data android:name="developer.origin" android:value="India" />
        <meta-data android:name="developer.site" android:value="https://vasudev-work.github.io" />
        <meta-data android:name="nijatva.suite" android:value="Nijatva" />
        <meta-data android:name="nijatva.signature" android:value="com.nijatva.signature" />

</application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- App theme: black window, themed dialogs -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#F59E0B</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>

    <!-- Every AlertDialog: dark rounded card, white text, accent buttons -->
    <style name="AppDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">#1E1E1E</item>
        <item name="android:colorAccent">#F59E0B</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#9E9E9E</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

</resources>
